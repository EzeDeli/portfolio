# Copiá este archivo como .env (o cargá las variables en el Programador de tareas).
# Si SMTP_HOST queda vacío, el proceso corre en modo demo y guarda el mail en salida/mails/.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=cuenta@empresa.com
SMTP_CLAVE=contraseña-de-aplicacion
MAIL_DE=cuenta@empresa.com
MAIL_PARA=administracion@empresa.com
